{
  "name": "cutroom",
  "version": "0.6.0",
  "description": "A local-first, open-source video editor controlled by text.",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": "Matheus Castro",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg --publish never",
    "dist:dir": "npm run build && electron-builder --dir --publish never"
  },
  "build": {
    "appId": "com.matheuscastro.cutroom",
    "productName": "CutRoom",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "asarUnpack": [
      "node_modules/@openai/codex*/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "resources/branding/icon.icns",
      "category": "public.app-category.video"
    },
    "dmg": {
      "icon": "resources/branding/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "resources/branding/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "resources/branding/icon.ico",
      "uninstallerIcon": "resources/branding/icon.ico",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "@hyperframes/core": "0.8.173",
    "@hyperframes/player": "0.8.173",
    "@hyperframes/producer": "0.8.173",
    "@openai/codex": "0.163.0",
    "fflate": "0.8.3",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "3.15.0",
    "jassub": "2.5.21",
    "linkedom": "0.18.12",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/ffprobe-static": "2.0.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
